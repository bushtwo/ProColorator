@import url('https://fonts.googleapis.com/css2?family=Inclusive+Sans:ital,wght@0,300..700;1,300..700&display=swap');

@font-face {
	font-family: 'Inclusive Sans';
	src: url('/fonts/InclusiveSans-Regular.woff2') format('woff2');
	font-weight: 400;
	font-style: normal;
	font-display: swap;
}

:root {
	--ui-scale: 1;

	--background: #150f00;
	--header: #05002f;

	--white: #ffffff;
	--muted: #666666;
	--divider: #77736a;

	--accent: #007f6f;

	--slider-track: #d9d9d9;
	--slider-thumb: #6e003d;

	--reference-width: 400px;
	--reference-height: 744px;
}

* {
	box-sizing: border-box;
}

html,
body,
#app {
width: 100%;
height: 100%;
margin: 0;
padding: 0;
overflow: hidden;
}

html {
	background: var(--background);
}

body {
	font-family:
	'Inclusive Sans',
	sans-serif;

	background: var(--background);
	color: var(--white);

	user-select: none;

	-webkit-font-smoothing: antialiased;
	text-rendering: geometricPrecision;
}

button,
input {
	font: inherit;
}

button {
	border: 0;
	padding: 0;
	margin: 0;
	background: none;
	color: inherit;
}

button:focus-visible,
input:focus-visible {
	outline: 1px solid var(--accent);
	outline-offset: 2px;
}

/* =========================================================
 *  Scaling system
 *
 *  The design itself NEVER reflows.
 *  It is always exactly 400 × 744 internally.
 *  The whole composition scales as a single visual unit.
 *  ========================================================= */

.viewport {
	position: relative;

	width: 100vw;
	height: 100vh;

	overflow: hidden;

	background: var(--background);
}

.design-stage {
	position: absolute;

	top: 0;
	left: 0;

	width: 400px;
	height: 744px;

	transform-origin: top left;

	overflow: visible;
}

.app-shell {
	position: relative;

	width: 400px;
	height: 744px;

	overflow: hidden;

	background: var(--background);

	color: var(--white);
}

/* =========================================================
 *  Title bar
 *  ========================================================= */

.titlebar {
	position: relative;

	display: flex;
	align-items: center;
	justify-content: space-between;

	width: 100%;
	height: 56px;

	padding: 0 16px 0 20px;

	background: var(--header);

	cursor: default;
}

.app-title {
	display: flex;
	align-items: center;

	height: 100%;

	font-size: 24px;
	font-weight: 500;
	line-height: 1;

	letter-spacing: -0.2px;
}

.close-button {
	display: flex;
	align-items: center;
	justify-content: center;

	width: 32px;
	height: 32px;

	border-radius: 4px;

	cursor: pointer;

	color: var(--white);
}

.close-button svg {
	width: 20px;
	height: 20px;

	flex: 0 0 20px;
}

.close-button:hover {
	background: rgba(255, 255, 255, 0.08);
}

/* =========================================================
 *  Main tabs
 *  ========================================================= */

.tabs {
	position: relative;

	display: grid;
	grid-template-columns: repeat(2, 1fr);

	width: 100%;
	height: 66px;

	padding: 0 18px;

	background: var(--background);
}

.tab-button {
	position: relative;

	display: flex;
	align-items: center;
	justify-content: center;

	gap: 8px;

	height: 66px;

	color: var(--muted);

	font-size: 17px;
	font-weight: 400;

	cursor: pointer;
}

.tab-icon {
	width: 20px;
	height: 20px;

	flex: 0 0 20px;
}

.tab-button:hover {
	color: var(--white);
}

.tab-button.active {
	color: var(--white);
}

.tab-button.active::after {
	content: '';

	position: absolute;

	left: 20px;
	right: 20px;
	bottom: 0;

	height: 3px;

	background: var(--accent);
}

/* =========================================================
 *  Selector page
 *  ========================================================= */

.selector-page {
	width: 100%;
	height: calc(744px - 122px);

	overflow: hidden;
}

.color-preview {
	position: relative;

	display: flex;
	align-items: center;
	justify-content: center;

	width: calc(100% - 40px);
	height: 196px;

	margin: 20px 20px 18px;

	overflow: hidden;
}

.picker-target {
	position: relative;

	display: flex;
	align-items: center;
	justify-content: center;

	width: 20px;
	height: 20px;

	border: 1.5px solid rgba(0, 0, 0, 0.8);

	border-radius: 50%;
}

.picker-target::before,
.picker-target::after {
	content: '';

	position: absolute;

	background: rgba(0, 0, 0, 0.8);
}

.picker-target::before {
	width: 1px;
	height: 26px;
}

.picker-target::after {
	width: 26px;
	height: 1px;
}

.picker-target span {
	position: relative;
	z-index: 2;

	width: 5px;
	height: 5px;

	border-radius: 50%;

	background: rgba(0, 0, 0, 0.9);
}

/* =========================================================
 *  Model buttons
 *
 *  STRICT 4 × 2.
 *  Never wraps differently.
 *  ========================================================= */

.model-grid {
	display: grid;

	grid-template-columns:
	repeat(4, minmax(0, 1fr));

	grid-template-rows:
	repeat(2, 40px);

	column-gap: 8px;
	row-gap: 8px;

	width: calc(100% - 40px);

	margin: 0 20px;
}

.model-button {
	position: relative;

	display: flex;
	align-items: center;
	justify-content: center;

	width: 100%;
	height: 40px;

	min-width: 0;

	border: 1px solid var(--divider);

	background: transparent;

	color: var(--muted);

	font-size: 14px;
	font-weight: 500;

	cursor: pointer;

	white-space: nowrap;
}

.model-button:hover {
	color: var(--white);
}

.model-button.active {
	color: var(--white);
	border-color: var(--accent);
}

.model-button.active::after {
	content: '';

	position: absolute;

	left: 7px;
	right: 7px;
	bottom: -1px;

	height: 3px;

	background: var(--accent);
}

/* =========================================================
 *  Controls
 *  ========================================================= */

.controls-panel {
	width: calc(100% - 40px);

	margin: 23px 20px 0;
}

.control-row {
	display: grid;

	grid-template-columns: 82px 1fr;

	align-items: center;

	width: 100%;

	margin-bottom: 14px;
}

.control-label {
	color: var(--white);

	font-size: 15px;
	font-weight: 400;
	line-height: 1;
}

.control-inputs {
	display: grid;

	grid-template-columns: 1fr 60px;

	align-items: center;

	column-gap: 12px;
}

/* =========================================================
 *  Custom slider
 *
 *  Removes browser / GTK-looking default visuals.
 *  ========================================================= */

.range-slider {
	width: 100%;
	height: 20px;

	margin: 0;

	padding: 0;

	background: transparent;

	cursor: pointer;

	appearance: none;
	-webkit-appearance: none;
}

.range-slider::-webkit-slider-runnable-track {
	width: 100%;
	height: 4px;

	border-radius: 2px;

	background: var(--slider-track);
}

.range-slider::-webkit-slider-thumb {
	width: 14px;
	height: 14px;

	margin-top: -5px;

	border: none;
	border-radius: 50%;

	background: var(--slider-thumb);

	box-shadow: none;

	appearance: none;
	-webkit-appearance: none;

	cursor: grab;
}

.range-slider::-webkit-slider-thumb:active {
	cursor: grabbing;
}

.range-slider::-moz-range-track {
	width: 100%;
	height: 4px;

	border: none;
	border-radius: 2px;

	background: var(--slider-track);
}

.range-slider::-moz-range-progress {
	height: 4px;

	border-radius: 2px;

	background: var(--slider-track);
}

.range-slider::-moz-range-thumb {
	width: 14px;
	height: 14px;

	border: none;
	border-radius: 50%;

	background: var(--slider-thumb);

	box-shadow: none;

	cursor: grab;
}

.range-slider::-moz-range-thumb:active {
	cursor: grabbing;
}

/* =========================================================
 *  Number values
 *
 *  No spinner arrows.
 *
 *  User can:
 *  - type
 *  - arrow keys
 *  - horizontal scrub by pointer dragging
 *  ========================================================= */

.number-input {
	width: 60px;
	height: 28px;

	padding: 0 7px;

	border: 1px solid var(--divider);
	border-radius: 0;

	background: transparent;

	color: var(--white);

	font-size: 14px;
	font-weight: 400;

	text-align: right;

	outline: none;

	cursor: ew-resize;

	-moz-appearance: textfield;
	appearance: textfield;
}

.number-input::-webkit-inner-spin-button,
.number-input::-webkit-outer-spin-button {
	margin: 0;

	-webkit-appearance: none;
	appearance: none;
}

.number-input:focus {
	border-color: var(--accent);

	cursor: text;
}

/* =========================================================
 *  HEX
 *  ========================================================= */

.hex-control {
	display: grid;

	grid-template-columns: 82px 1fr;

	align-items: center;

	min-height: 42px;
}

.hex-control label {
	font-size: 15px;
}

.hex-input {
	width: 100%;
	height: 34px;

	padding: 0 10px;

	border: 1px solid var(--divider);
	border-radius: 0;

	background: transparent;

	color: var(--white);

	font-size: 15px;

	text-transform: uppercase;

	outline: none;
}

.hex-input:focus {
	border-color: var(--accent);
}

/* =========================================================
 *  Copy button
 *  ========================================================= */

.copy-button {
	display: flex;

	align-items: center;
	justify-content: center;

	flex-direction: row;

	gap: 9px;

	width: 100%;
	height: 42px;

	margin-top: 32px;

	border: 1px solid var(--white);

	background: transparent;

	color: var(--white);

	font-size: 15px;
	font-weight: 500;

	cursor: pointer;
}

.copy-icon {
	display: block;

	width: 20px;
	height: 20px;

	flex: 0 0 20px;
}

.copy-button:hover {
	background: rgba(255, 255, 255, 0.06);
}

.copy-button:active {
	transform: translateY(1px);
}

/* =========================================================
 *  History
 *  ========================================================= */

.history-page {
	display: flex;
	flex-direction: column;

	width: 100%;
	height: calc(744px - 122px);

	overflow: hidden;
}

.history-header {
	display: flex;
	align-items: center;
	justify-content: space-between;

	flex: 0 0 auto;

	height: 60px;

	padding: 0 20px;

	border-bottom: 1px solid rgba(119, 115, 106, 0.6);
}

.history-header p {
	margin: 0;

	color: var(--white);

	font-size: 13px;
	font-weight: 400;
}

.history-view-toggle {
	display: flex;

	gap: 5px;
}

.history-view-toggle button {
	display: flex;
	align-items: center;
	justify-content: center;

	width: 30px;
	height: 30px;

	color: var(--muted);

	cursor: pointer;
}

.history-view-toggle button svg {
	width: 20px;
	height: 20px;
}

.history-view-toggle button:hover,
.history-view-toggle button.active {
	color: var(--white);
}

.history-view-toggle button.active {
	background: rgba(0, 127, 111, 0.25);
}

/* ONLY THIS AREA SCROLLS */

.history-scroll {
	flex: 1 1 auto;

	min-height: 0;

	overflow-x: hidden;
	overflow-y: auto;

	padding-right: 5px;

	scrollbar-width: thin;
	scrollbar-color:
	var(--divider)
	transparent;
}

.history-scroll::-webkit-scrollbar {
	width: 6px;
}

.history-scroll::-webkit-scrollbar-track {
	background: transparent;
}

.history-scroll::-webkit-scrollbar-thumb {
	border-radius: 3px;

	background: var(--divider);
}

/* History list */

.history-list {
	padding: 0 20px;
}

.history-row {
	display: flex;
	align-items: center;
	justify-content: space-between;

	width: 100%;
	min-height: 68px;

	border-bottom: 1px solid var(--divider);

	cursor: pointer;

	text-align: left;
}

.history-text {
	display: flex;
	flex-direction: column;

	gap: 5px;
}

.history-name {
	color: var(--white);

	font-size: 15px;
}

.history-hex {
	color: var(--muted);

	font-size: 13px;
}

.history-swatch {
	width: 38px;
	height: 38px;

	flex: 0 0 38px;

	border: 1px solid rgba(255, 255, 255, 0.25);
}

/* History grid */

.history-grid {
	display: grid;

	grid-template-columns: repeat(3, 1fr);

	gap: 12px;

	padding: 18px 20px 20px;
}

.history-card {
	display: flex;
	flex-direction: column;

	gap: 7px;

	width: 100%;

	cursor: pointer;

	text-align: left;
}

.history-card-color {
	width: 100%;
	aspect-ratio: 1;

	border: 1px solid rgba(255, 255, 255, 0.18);
}

.history-card span {
	color: var(--white);

	font-size: 12px;
}

.history-empty {
	display: flex;
	align-items: center;
	justify-content: center;

	height: 100%;

	color: var(--muted);

	font-size: 14px;
}

/* =========================================================
 *  Floating copied toast
 *
 *  Absolutely positioned.
 *  Does NOT participate in document flow.
 *  Does NOT create scrollbars.
 *  ========================================================= */

.copy-toast {
	position: absolute;

	z-index: 1000;

	left: 50%;
	bottom: 22px;

	display: flex;
	align-items: center;

	gap: 8px;

	max-width: 330px;
	min-height: 38px;

	padding: 8px 12px;

	transform: translateX(-50%);

	background: var(--white);

	color: #150f00;

	font-size: 13px;
	font-weight: 500;

	box-shadow:
	0 6px 20px
	rgba(0, 0, 0, 0.28);

	pointer-events: none;

	animation:
	toast-in
	140ms ease-out;
}

.toast-icon {
	width: 20px;
	height: 20px;

	flex: 0 0 20px;
}

@keyframes toast-in {
	from {
		opacity: 0;
		transform:
		translate(-50%, 5px);
	}

	to {
		opacity: 1;
		transform:
		translate(-50%, 0);
	}
}

/* =========================================================
 *  Invisible resize regions
 *
 *  These are NOT buttons.
 *  Nothing is drawn on screen.
 *
 *  The resize cursor only appears at the four corners.
 *  ========================================================= */

.resize-corner {
	position: absolute;

	z-index: 9999;

	width: 12px;
	height: 12px;

	background: transparent;

	opacity: 0;
}

.resize-nw {
	top: 0;
	left: 0;

	cursor: nwse-resize;
}

.resize-ne {
	top: 0;
	right: 0;

	cursor: nesw-resize;
}

.resize-sw {
	bottom: 0;
	left: 0;

	cursor: nesw-resize;
}

.resize-se {
	right: 0;
	bottom: 0;

	cursor: nwse-resize;
}
